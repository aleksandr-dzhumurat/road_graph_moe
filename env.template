# Nebius HMAC credentials (from ~/.aws/credentials [nebius])
# Used by create-s3-secret; prefer reading directly from ~/.aws/credentials
key_id=<your_hmac_key_id>
secret_key=<your_hmac_secret_key>

# Container registry and image settings
REGISTRY=cr.eu-north1.nebius.cloud/<your_registry_id>
IMAGE_NAME=trajectory-train
IMAGE_TAG=latest
SSH_KEY=~/.ssh/nebius

# Nebius project / network identifiers (find in Nebius console)
PROJECT_ID=project-<your_project_id>
SUBNET_ID=vpcsubnet-<your_subnet_id>
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
